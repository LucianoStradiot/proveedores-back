{
  "name": "portalproveedores_cap",
  "version": "1.0.0",
  "description": "CAP - Portal de proveedores",
  "repository": "https://github.com/pablok5k/Abastible_PortalProveedores.git",
  "license": "UNLICENSED",
  "engines": {
    "node": "^24"
  },
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.13.2",
    "@dynatrace/oneagent-sdk": "^1.5.0",
    "@sap-cloud-sdk/connectivity": "^3.16.0",
    "@sap-cloud-sdk/http-client": "^3.16.0",
    "@sap/audit-logging": "^6",
    "@sap/cds": "^8",
    "@sap/cds-dk": "^8",
    "@sap/cds-hana": "^2",
    "@sap/cds-odata-v2-adapter-proxy": "^1",
    "@sap/hdbext": "^8.0.6",
    "@sap/logging": "^8.2.0",
    "@sap/textbundle": "^5.2.0",
    "@sap/xsenv": "^5.2.0",
    "@sap/xssec": "^4.2.7",
    "axios": "^1.7.7",
    "cfenv": "^1.2.4",
    "cookie-parser": "^1.4.7",
    "express": "^4",
    "express-rate-limit": "^8.5.2",
    "file-type": "^22.0.1",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "node-fetch": "^2.7.0",
    "passport": "^0.7.0",
    "qs": "^6.12.3",
    "request": "^2.88.2",
    "require": "^0.4.4",
    "uuid": "^9.0.0"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "npx jest --silent",
    "watch-app_crud_profiles": "cds watch --open app_crud_profiles/webapp/index.html?sap-ui-xx-viewCache=false",
    "undeploy": "cf undeploy PORTALPROVEEDORES_CAP --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana-cloud",
        "pool": {
          "max": 1400,
          "min": 100
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "env": {
        "remote": {
          "max_body_length": 1000
        }
      },
      "ZMM_PORTAL_PROVEEDORES_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/ZMM_PORTAL_PROVEEDORES_SRV",
        "csrf": true,
        "csrfInBatch": true,
        "[production]": {
          "credentials": {
            "destination": "DESTINATION_FIORI_GW_PPC",
            "path": "/sap/opu/odata/sap/ZMM_PORTAL_PROVEEDORES_SRV"
          }
        },
        "destination": true
      },
      "destination": true
    },
    "server": {
      "body_parser": {
        "limit": "20mb"
      }
    }
  },
  "sapux": [
    "app/app_crud_profiles"
  ],
  "devDependencies": {
    "rimraf": "^5.0.5"
  }
}

